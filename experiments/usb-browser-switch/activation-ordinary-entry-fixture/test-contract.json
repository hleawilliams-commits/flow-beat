{
  "schema": 1,
  "status": "source-frozen-not-executed",
  "scope": "New ordinary synchronous entry and public post-return evidence only; authored setup completed before entry, with separately reported post-return refusal probes. No private scheduling, native provider, thread, signal, loader, installer or device execution.",
  "configuration": "AO_WITNESS_SETUP",
  "summary_keys": [
    "schema",
    "selector",
    "checks",
    "check_names",
    "failures",
    "failed_checks"
  ],
  "selectors": {
