+        let joined=w.join().unwrap();let copied=joined.accounting();drop(p);drop(f.route);
+        let retained={let r=f.r.lock().unwrap();(r.backend_drops,r.sink_drops,r.calls,r.settings,r.baseline_calls)};
+        drop(joined);let released={let r=f.r.lock().unwrap();(r.backend_drops,r.sink_drops,r.calls,r.settings,r.baseline_calls)};
+        assert_eq!(retained,(0,0,1,0,1));
+        assert_eq!(released,(1,1,1,0,1));
+        assert_eq!(copied.route.producer.status.unresolved,Some(Pending {request:e,uncertain:true}));
+        // Copied diagnostics survive locally, but no endpoint/query/restoration
+        // ownership follows from retaining this ordinary Copy value.
