+    #[test] fn joined_prior_commit_survives_later_noncommit_diagnostic() {
+        let f=fixture(false);let (p,w,start,b)=paused(&f);
+        let (entered,arrived)=mpsc::channel();let (resume,proceed)=mpsc::channel();
+        *p.shared().after_dispatch.lock().unwrap()=Some((entered,proceed));
+        let first=p.enqueue_for_key(b.key,frame(7)).unwrap();let second=p.enqueue_for_key(b.key,frame(8)).unwrap();
+        start.send(()).unwrap();arrived.recv().unwrap();f.r.lock().unwrap().reply=Reply::Reject;resume.send(()).unwrap();
+        f.entered.recv().unwrap();f.entered.recv().unwrap();let joined=w.join().unwrap();
