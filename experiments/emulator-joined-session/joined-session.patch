+        assert_eq!(joined.last_ack(),Some(AckCheckpoint {ack:FrameAck {request:first,kernel_sequence:8},settings:AckSettings::ReturnedOk}));
+        assert!(joined.accounting().route.producer.status.unresolved.is_none());assert_eq!(f.r.lock().unwrap().calls,2);
