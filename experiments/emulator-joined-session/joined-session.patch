+            let (p,w,start,b)=paused(&f);let clone=p.clone();let e=p.enqueue_for_key(b.key,frame(2)).unwrap();
+            start.send(()).unwrap();f.entered.recv().unwrap();let joined=w.join().unwrap();
+            let a=joined.accounting();let resume=clone.enqueue_for_key(b.key,frame(3));
+            assert_eq!(joined.exit(),WorkerExit::Stopped);assert!(!a.mailbox.poisoned);assert!(!a.route.endpoint_poisoned);assert!(!a.route.producer.poisoned);
+            assert_eq!(a.route.producer.status.unresolved,Some(Pending {request:e,uncertain:!malformed}));
+            assert_eq!(joined.last_ack(),None);assert_eq!(a.route.producer.status.kernel_sequence,7);
+            assert_eq!(resume,Err(TransportError::Terminal));assert_eq!(f.r.lock().unwrap().calls,1);
+            assert_eq!(f.r.lock().unwrap().settings,0);
+        }
