+            let (p,w,start,b)=paused(&f);let e=p.enqueue_for_key(b.key,frame(4)).unwrap();start.send(()).unwrap();
+            let actual=f.settings_entered.recv().unwrap();f.settings_go.send(()).unwrap();let joined=w.join().unwrap();
+            let a=joined.accounting();let expected=AckCheckpoint {ack:FrameAck {request:e,kernel_sequence:8},
+                settings:if panic {AckSettings::CallbackArmed} else {AckSettings::ReturnedErr}};
+            assert_eq!(joined.last_ack(),Some(expected));
+            assert_eq!(actual,expected.ack);assert_eq!(a.route.producer.status.kernel_sequence,8);assert!(a.route.producer.status.unresolved.is_none());
+            assert_eq!(a.route.producer.poisoned,panic);assert_eq!(a.route.endpoint_poisoned,panic);
+            assert_eq!(joined.exit(),if panic {WorkerExit::Panicked} else {WorkerExit::Stopped});
+            assert_eq!(p.enqueue_for_key(b.key,frame(5)),Err(TransportError::Terminal));
+            let r=f.r.lock().unwrap();assert_eq!((r.calls,r.settings),(1,1));
+        }
+    }
