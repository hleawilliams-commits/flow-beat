+    #[test]
+    fn pre_take_poison_is_unjoined_and_test_cleanup_never_becomes_a_receipt() {
+        let mut f = fixture(Reply::Unknown, false, Settings::Ok, false); let owner = f.owner::<()>(None);
+        let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let _guard = owner.state.lock().unwrap(); panic!("poison before finish");
+        }));
+        let result = owner.finish(); let before = owner.snapshot().unwrap();
+        // Test-only custody recovery joins the actual handle; production has no
+        // such accessor and the owner must still report its unproven phase.
+        let worker = match owner.state.lock() {
+            Err(error) => error.into_inner().worker.take().unwrap(),
+            Ok(_) => panic!("test poison missing"),
+        };
+        let actual = worker.join().unwrap(); let after = owner.snapshot().unwrap();
+        assert_eq!(result, FinishStatus::OwnerPoisoned); assert!(before.owner_poisoned);
+        assert_eq!(before.phase, LifecyclePhase::Running); assert_eq!(before.stop, StopStatus::NotRecorded);
+        assert!(before.joined.is_none()); assert_eq!(after, before); assert_eq!(actual.exit(), WorkerExit::Stopped);
+    }
