+// SPDX-License-Identifier: GPL-3.0-only
+//! Inactive local lifecycle owner. No backend factory or guest teardown API.
+//!
+//! The owner keeps the paired worker, port, optional supervisor and exact joined
+//! session across App exit and a returning GUI runner. A local join is never a
+//! permit to send Quit, stop the guest, release the backend, or restore files.
+//! There is deliberately no Drop cleanup claim: ordinary final Drop may close
+//! the supervisor pipe/backend, and process termination can stop the guest.
+//! Those policies, panic/abort paths, and owned recovery remain unimplemented.
+//! A returning runner is covered; macOS process termination need not return it.
+//! Backend/settings callbacks must not initiate finish or wait on a thread doing
+//! so. The worker-ID check prevents only direct self-join, not dependency cycles.
+
+use crate::mixer_transport::{JoinedAccounting, JoinedMixerSession, MixerPort,
+    MixerWorker, StopReceipt, TransportError, WorkerExit};
+use std::sync::{Arc, Mutex};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum LifecyclePhase { Running, Joining, Retained, JoinUnproven }
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum GuestPresence { SupervisorResource, NoSupervisorResource }
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum FinishStatus { InProgress, RecoveryRequired, JoinUnproven,
+    WorkerThreadRefused, OwnerPoisoned }
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum StopStatus { NotRecorded, ReturnedOk { discarded: usize, in_flight: bool },
+    ReturnedErr(String) }
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct LifecycleSnapshot {
+    /// Poison dominates all salvaged fields; never authorizes an operation.
+    pub owner_poisoned: bool,
+    pub phase: LifecyclePhase,
+    pub guest: GuestPresence,
+    pub stop: StopStatus,
+    pub joined_exit: Option<WorkerExit>,
+    pub joined: Option<JoinedAccounting>,
+    pub join_error: Option<String>,
+}
+
+/// The App can request completion and read copied local diagnostics. It cannot
+/// obtain the guest, worker or session, or authorize resource release.
+pub trait LifecycleControl: Send + Sync {
+    fn port(&self) -> Arc<MixerPort>;
+    fn finish(&self) -> FinishStatus;
+    fn snapshot(&self) -> Result<LifecycleSnapshot, FinishStatus>;
+}
+
+struct State<G> {
+    phase: LifecyclePhase,
+    worker: Option<MixerWorker>,
+    // Neither guest nor session is taken by finish; no extraction API exists.
+    guest: Option<G>,
+    stop: Option<Result<StopReceipt, TransportError>>,
+    joined: Option<JoinedMixerSession>,
+    join_error: Option<TransportError>,
+}
+
+pub struct OwnedLifecycle<G> { port: Arc<MixerPort>, state: Mutex<State<G>> }
+
+/// Failed pairing returns every input without stopping, joining or dropping it.
+/// Caller ownership does not establish recovery; eventually dropping these
+/// resources still has the ordinary process/supervisor lifetime limitations.
+pub struct RejectedOwner<G> {
+    pub port: Arc<MixerPort>,
+    pub worker: MixerWorker,
+    pub guest: Option<G>,
+}
+
+impl<G: Send> OwnedLifecycle<G> {
+    /// Real owned Windows construction is deliberately unavailable: Launched is
+    /// a PID there, not ownership of the Windows job resource. Tests use fake G.
+    #[cfg(any(unix, test))]
+    pub(crate) fn try_new(port: Arc<MixerPort>, worker: MixerWorker, guest: Option<G>)
+        -> Result<Self, RejectedOwner<G>> {
+        if !worker.is_paired_with(&port) {
+            return Err(RejectedOwner { port, worker, guest });
+        }
+        Ok(Self { port, state: Mutex::new(State { phase: LifecyclePhase::Running,
+            worker: Some(worker), guest, stop: None, joined: None, join_error: None }) })
+    }
+
+    pub fn port(&self) -> Arc<MixerPort> { self.port.clone() }
+
+    /// Idempotent after a completed attempt. Concurrent/reentrant callers see
+    /// Joining, without waiting for the backend while holding the owner lock.
+    /// A first call from the worker is refused before any resource is taken.
+    pub fn finish(&self) -> FinishStatus {
+        let worker = {
+            let Ok(mut s) = self.state.lock() else { return FinishStatus::OwnerPoisoned };
+            match s.phase {
+                LifecyclePhase::Joining => return FinishStatus::InProgress,
+                LifecyclePhase::Retained => return FinishStatus::RecoveryRequired,
+                LifecyclePhase::JoinUnproven => return FinishStatus::JoinUnproven,
+                LifecyclePhase::Running => {}
+            }
+            let Some(worker) = s.worker.as_ref() else { return FinishStatus::JoinUnproven };
+            if worker.is_current_thread() { return FinishStatus::WorkerThreadRefused; }
+            s.phase = LifecyclePhase::Joining;
+            s.worker.take().expect("paired worker retained while Running")
+        };
+        // Stop can fail on poisoned accounting. It never excuses skipping the
+        // real join, and neither operation runs under the lifecycle mutex.
+        let stop = self.port.request_stop();
+        let joined = worker.join();
+        // A poisoned owner still retains the exact completed results. Salvage
+        // does not clear poison or permit another operation.
+        let (mut s, poisoned) = match self.state.lock() {
+            Ok(s) => (s, false), Err(error) => (error.into_inner(), true),
+        };
+        s.stop = Some(stop);
+        let result = match joined {
+            Ok(session) => {
+                s.joined = Some(session);
+                s.phase = LifecyclePhase::Retained;
+                FinishStatus::RecoveryRequired
+            }
+            Err(error) => {
+                s.join_error = Some(error);
+                s.phase = LifecyclePhase::JoinUnproven;
+                FinishStatus::JoinUnproven
+            }
+        };
+        if poisoned { FinishStatus::OwnerPoisoned } else { result }
+    }
+
+    /// Copied bounded accounting only, including poison flags inside joined.
+    /// No callback, backend query or guest failure poll is performed here.
+    pub fn snapshot(&self) -> Result<LifecycleSnapshot, FinishStatus> {
+        let (s, owner_poisoned) = match self.state.lock() {
+            Ok(s) => (s, false), Err(error) => (error.into_inner(), true),
+        };
+        let stop = match &s.stop {
+            None => StopStatus::NotRecorded,
+            Some(Ok(r)) => StopStatus::ReturnedOk { discarded: r.discarded(),
+                in_flight: r.had_in_flight() },
+            Some(Err(error)) => StopStatus::ReturnedErr(format!("{error:?}")),
+        };
+        Ok(LifecycleSnapshot { owner_poisoned, phase: s.phase,
+            guest: if s.guest.is_some() { GuestPresence::SupervisorResource }
+                else { GuestPresence::NoSupervisorResource },
+            stop, joined_exit: s.joined.as_ref().map(JoinedMixerSession::exit),
+            joined: s.joined.as_ref().map(JoinedMixerSession::accounting),
+            join_error: s.join_error.as_ref().map(|e| format!("{e:?}")) })
+    }
+}
+impl<G: Send> LifecycleControl for OwnedLifecycle<G> {
+    fn port(&self) -> Arc<MixerPort> { self.port() }
+    fn finish(&self) -> FinishStatus { self.finish() }
+    fn snapshot(&self) -> Result<LifecycleSnapshot, FinishStatus> { self.snapshot() }
+}
+
+/// Main keeps this result outside the App-creator closure. NoSupervisorResource
+/// means only that no resource was supplied; it does not prove attachment.
+#[cfg(any(unix, test))]
+pub(crate) fn partition_launch<G: Send>(pair: Option<(Arc<MixerPort>, MixerWorker)>,
+    guest: Option<G>) -> Result<(Option<Arc<OwnedLifecycle<G>>>, Option<G>), RejectedOwner<G>> {
+    match pair {
+        None => Ok((None, guest)),
+        Some((port, worker)) => OwnedLifecycle::try_new(port, worker, guest)
+            .map(|owner| (Some(Arc::new(owner)), None)),
+    }
+}
+
+/// Covers every returning result, including creator/run errors; it preserves the
+/// original return value and leaves the exact completion in the external owner.
+/// It is not a panic/unwind guard and is not process-death recovery.
+pub(crate) fn run_with_owner<G: Send, R>(owner: &Option<Arc<OwnedLifecycle<G>>>,
+    run: impl FnOnce() -> R) -> R {
+    let result = run();
+    if let Some(owner) = owner { let _ = owner.finish(); }
+    result
+}
+
