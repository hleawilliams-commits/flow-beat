+    #[test]
+    fn owner_poison_during_join_keeps_exact_completed_session_and_stop_result() {
+        let mut f = fixture(Reply::Unknown, true, Settings::Ok, false);
+        let owner = f.owner::<()>(None);
+        let request = f.port.enqueue_for_key(f.baseline.key, f.baseline.frame).unwrap(); f.entered.recv().unwrap();
+        let other = owner.clone(); let joining = thread::spawn(move || other.finish());
+        let observed = wait_joining(&owner);
+        if observed {
+            let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                let _guard = owner.state.lock().unwrap(); panic!("poison owner while joining");
+            }));
+        }
+        f.proceed.send(()).unwrap(); let finished = joining.join().unwrap();
+        let s = owner.snapshot().unwrap(); let repeat = owner.finish();
+        assert!(observed); assert_eq!(finished, FinishStatus::OwnerPoisoned);
+        assert!(s.owner_poisoned);
+        assert_eq!(s.phase, LifecyclePhase::Retained);
+        assert!(matches!(s.stop, StopStatus::ReturnedOk { .. }));
+        assert!(s.joined.is_some());
+        assert_eq!(s.joined.unwrap().route.producer.status.unresolved,
+            Some(Pending { request, uncertain: true }));
+        assert_eq!(s.joined_exit, Some(WorkerExit::Stopped)); assert_eq!(repeat, FinishStatus::OwnerPoisoned);
