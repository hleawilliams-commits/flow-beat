+        let observed = wait_joining(&owner);
+        f.settings_proceed.send(()).unwrap(); let finished = joining.join().unwrap();
+        let s = owner.snapshot().unwrap();
+        let typed_stop_error = matches!(&owner.state.lock().unwrap().stop, Some(Err(TransportError::Route(_))));
+        assert!(observed); assert_eq!(finished, FinishStatus::RecoveryRequired);
+        assert!(typed_stop_error);
+        assert_eq!(s.phase, LifecyclePhase::Retained); assert_eq!(s.joined_exit, Some(WorkerExit::Panicked));
+        let a = s.joined.unwrap(); assert!(a.route.producer.poisoned && a.route.endpoint_poisoned);
+        assert!(a.route.producer.status.unresolved.is_none());
+        let exact = a.route.producer.status.last_ack.unwrap();
+        assert_eq!(exact.ack, ack); assert_eq!(exact.ack.request, request);
+        assert_eq!(exact.settings, AckSettings::CallbackArmed);
