+    fn wait_joining<G: Send>(owner: &OwnedLifecycle<G>) -> bool {
+        let deadline = Instant::now() + Duration::from_secs(5);
+        while Instant::now() < deadline {
+            if owner.snapshot().unwrap().phase == LifecyclePhase::Joining { return true; }
+            thread::yield_now();
+        }
+        false
+    }
+    fn drops(count: &Arc<AtomicUsize>) -> usize { count.load(Ordering::SeqCst) }
+
+    #[test]
+    fn rejected_pair_returns_every_resource_without_implicit_stop() {
+        let mut a = fixture(Reply::Unknown, false, Settings::Ok, false);
+        let mut b = fixture(Reply::Unknown, false, Settings::Ok, false);
+        let guest = Arc::new(AtomicUsize::new(0));
+        let result = partition_launch(Some((a.port.clone(), b.worker.take().unwrap())), Some(Guest(guest.clone())));
+        let (rejected, intact, pre_drop, second_exit) = match result {
+            Err(r) => {
+                let intact = Arc::ptr_eq(&r.port, &a.port) && r.worker.is_paired_with(&b.port) && r.guest.is_some();
+                let pre_drop = drops(&guest);
+                let exit = r.worker.join().unwrap().exit(); drop(r.guest); drop(r.port);
+                (true, intact, pre_drop, exit)
+            }
+            Ok((owner, _)) => {
+                let owner = owner.unwrap(); let _ = owner.finish();
+                let exit = owner.snapshot().unwrap().joined_exit.unwrap(); drop(owner);
+                (false, false, drops(&guest), exit)
+            }
+        };
+        // Both actual handles are joined before any control assertion.
+        let first_exit = a.worker.take().unwrap().join().unwrap().exit();
+        assert!(rejected);
+        assert!(intact); assert_eq!(pre_drop, 0); assert_eq!(drops(&guest), 1);
+        assert_eq!((first_exit, second_exit), (WorkerExit::Stopped, WorkerExit::Stopped));
+    }
+
+    #[test]
+    fn returning_creator_error_joins_once_and_retains_guest_and_backend() {
+        let mut f = fixture(Reply::Unknown, false, Settings::Ok, false);
+        let guest = Arc::new(AtomicUsize::new(0)); let owner = f.owner(Some(Guest(guest.clone())));
+        let creator_clone = owner.clone(); let external = Some(owner.clone());
+        let original: Result<(), &str> = run_with_owner(&external, move || {
+            drop(creator_clone); Err("creator failed before App")
+        });
+        let first = owner.snapshot().unwrap();
+        // Cleanup also makes the omitted-fallback control safe before its oracle.
+        let repeat = owner.finish(); let second = owner.snapshot().unwrap();
+        let retained = (drops(&guest), f.counts.backend_drops.load(Ordering::SeqCst));
+        drop(external); drop(f.port); drop(owner);
+        let released = (drops(&guest), f.counts.backend_drops.load(Ordering::SeqCst));
+        assert_eq!(first.phase, LifecyclePhase::Retained);
+        assert_eq!(first, second); assert_eq!(repeat, FinishStatus::RecoveryRequired);
+        assert_eq!(original, Err("creator failed before App"));
+        assert_eq!(retained, (0, 0)); assert_eq!(released, (1, 1));
+        assert!(first.joined.unwrap().mailbox.status.worker_exited);
+    }
+
+    #[test]
+    fn joining_is_visible_without_locking_out_idempotent_calls_or_dropping_guest() {
+        let mut f = fixture(Reply::Unknown, true, Settings::Ok, false);
+        let guest = Arc::new(AtomicUsize::new(0)); let owner = f.owner(Some(Guest(guest.clone())));
+        let request = f.port.enqueue_for_key(f.baseline.key, f.baseline.frame).unwrap();
+        f.entered.recv().unwrap();
+        let other = owner.clone(); let joining = thread::spawn(move || other.finish());
+        let observed = wait_joining(&owner);
+        let during = owner.snapshot().unwrap();
+        let repeated = if observed { owner.finish() } else { FinishStatus::JoinUnproven };
+        let retained = drops(&guest);
+        f.proceed.send(()).unwrap(); let finished = joining.join().unwrap();
+        let after = owner.snapshot().unwrap(); drop(f.port); drop(owner);
+        assert!(observed); assert_eq!(during.phase, LifecyclePhase::Joining);
+        assert_eq!(repeated, FinishStatus::InProgress); assert_eq!(retained, 0);
+        assert_eq!(finished, FinishStatus::RecoveryRequired);
+        assert_eq!(after.joined.unwrap().route.producer.status.unresolved,
+            Some(Pending { request, uncertain: true }));
+        assert_eq!(after.joined_exit, Some(WorkerExit::Stopped)); assert_eq!(drops(&guest), 1);
+    }
