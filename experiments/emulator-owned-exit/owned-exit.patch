+        let (cx, callback_result) = mpsc::channel(); let callback = Arc::new(Mutex::new(None));
+        let route = Arc::new(MixerRoute::new(4, Box::new(Backend { counts: counts.clone(), reply,
+            baseline, entered: tx, proceed: hold_submit.then_some(rx), callback: callback.clone(), callback_result: cx }),
+            Box::new(Sink { counts: counts.clone(), behavior: settings,
+                entered: sx, proceed: hold_settings.then_some(sr) })).unwrap());
+        let b = route.refresh_baseline().unwrap(); route.confirm_adoption(b, true).unwrap();
+        let (port, worker) = mixer_transport::channel(route, 4).unwrap();
+        Fixture { port: Arc::new(port), worker: Some(worker), counts, baseline, entered, proceed,
+            settings_entered, settings_proceed, callback, callback_result }
+    }
+}
