+            let (route,r)=fresh(reply); let b=arm(&route); let e=queued(&route,b,2);
+            assert!(route.dispatch(e).is_err()); let s=route.producer.inspect().unwrap();
+            assert!(!s.admission_open); assert_eq!(s.unresolved.unwrap().request,e);
+            assert!(r.lock().unwrap().acks.is_empty());
+        }
+    }
+    #[test] fn settings_failure_preserves_commit_and_does_not_retry() {
+        let (route,r)=fresh(Reply::Commit); r.lock().unwrap().settings_fail=true;
+        let b=arm(&route); let e=queued(&route,b,2);
+        assert_eq!(route.dispatch(e).unwrap(),DispatchResult::CommittedSettingsFailed("partial settings failure".into()));
+        let s=route.producer.inspect().unwrap(); assert!(!s.admission_open);
+        assert!(s.unresolved.is_none()); assert_eq!(s.kernel_sequence,5);
+        assert!(route.dispatch(e).is_err()); let r=r.lock().unwrap();
+        assert_eq!(r.calls,vec![e]); assert_eq!(r.acks.len(),1);
+    }
+    struct Block { baseline:BaselineReceipt, entered:Sender<Envelope>, proceed:Receiver<()> }
+    impl MixerBackend for Block {
+        fn baseline(&mut self)->Result<BaselineReceipt,String> {Ok(self.baseline)}
+        fn submit(&mut self,e:Envelope)->BackendOutcome {
+            self.entered.send(e).unwrap(); self.proceed.recv().unwrap();
+            self.baseline.kernel_sequence+=1;
+            BackendOutcome::Committed(FrameAck {request:e,kernel_sequence:self.baseline.kernel_sequence})
+        }
+    }
+    #[test] fn close_during_submit_allows_late_positive_without_settings() {
+        let (_,r)=fresh(Reply::Commit); let (tx,rx)=channel(); let (go,proceed)=channel();
+        let route=Arc::new(MixerRoute::new(2,Box::new(Block {baseline:baseline(1),entered:tx,proceed}),
+            Box::new(Sink(r.clone()))).unwrap());
+        let b=arm(&route); let e=queued(&route,b,4); let worker=route.clone();
+        let t=thread::spawn(move || worker.dispatch(e)); assert_eq!(rx.recv().unwrap(),e);
+        // No sleep or timeout: this call must return while backend waits for
+        // the caller's go message. A blocking endpoint read would deadlock.
+        assert_eq!(route.staged_baseline(),None);
+        assert_eq!(route.confirm_adoption(b,true),Err(RouteError::Gate(Error::Busy)));
+        assert_eq!(route.current_key(),Some(b.key));
+        route.close().unwrap(); assert_eq!(route.current_key(),None); go.send(()).unwrap();
+        assert_eq!(t.join().unwrap().unwrap(),DispatchResult::Committed {settings_written:false});
+        assert!(route.producer.inspect().unwrap().unresolved.is_none());
+        assert_eq!(route.current_key(),None); assert!(r.lock().unwrap().acks.is_empty());
+    }
+    struct BlockingSink { entered:Sender<FrameAck>, proceed:Receiver<()> }
+    impl SettingsSink for BlockingSink {
+        fn commit(&mut self, ack:FrameAck)->Result<(),String> {
+            self.entered.send(ack).unwrap(); self.proceed.recv().unwrap(); Ok(())
+        }
+    }
+    #[test] fn ui_status_does_not_wait_for_settings_callback() {
+        let (_,r)=fresh(Reply::Commit);let (entered,seen)=channel();let (go,proceed)=channel();
+        let route=Arc::new(MixerRoute::new(2,Box::new(Fake(r)),
+            Box::new(BlockingSink {entered,proceed})).unwrap());
+        let b=arm(&route);let e=queued(&route,b,4);let worker=route.clone();
+        let t=thread::spawn(move ||worker.dispatch(e));assert_eq!(seen.recv().unwrap().request,e);
+        // The callback owns the producer gate until go. These observation
+        // methods must return immediately rather than wait for that callback.
+        assert_eq!(route.current_key(),None);assert_eq!(route.staged_baseline(),None);
+        assert_eq!(route.confirm_adoption(b,true),Err(RouteError::Gate(Error::Busy)));
+        go.send(()).unwrap();assert_eq!(t.join().unwrap().unwrap(),
+            DispatchResult::Committed {settings_written:true});
+        assert_eq!(route.current_key(),Some(b.key));
+    }
+    #[test] fn backend_panic_closes_and_retains_unknown_no_endpoint_replacement() {
+        let (route,r)=fresh(Reply::Panic); let b=arm(&route); let e=queued(&route,b,2);
+        assert!(std::panic::catch_unwind(std::panic::AssertUnwindSafe(||route.dispatch(e))).is_err());
+        let s=route.producer.inspect().unwrap(); assert!(!s.admission_open);
+        assert_eq!(s.unresolved.unwrap().request,e); assert!(s.unresolved.unwrap().uncertain);
+        assert_eq!(route.refresh_baseline(),Err(RouteError::EndpointPoisoned));
+        assert_eq!(r.lock().unwrap().calls,vec![e]);
+    }
+    #[test] fn only_a_new_verified_epoch_can_rearm_after_known_rejection() {
+        let (route,r)=fresh(Reply::Reject); let b=arm(&route); let e=queued(&route,b,2);
+        route.dispatch(e).unwrap(); assert!(route.refresh_baseline().is_err());
+        {let mut r=r.lock().unwrap();r.baseline=baseline(2);r.reply=Reply::Commit;}
+        let b2=arm(&route); assert_ne!(b.key,b2.key); let next=queued(&route,b2,3);
+        assert_eq!(next.request_id(),1); route.dispatch(next).unwrap();
+        assert!(route.dispatch(e).is_err()); assert_eq!(r.lock().unwrap().calls,vec![e,next]);
+    }
+}
