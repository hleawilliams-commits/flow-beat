+// SPDX-License-Identifier: GPL-3.0-only
+//! Inactive same-process mixer seam. The injected endpoint is trusted to retain
+//! one broker session; this module implements no socket, ioctl, fd or settings I/O.
+//! Receipts are not self-authenticating. No backend is constructed by main.
+
+use crate::mixer_producer::{BaselineReceipt, Envelope, Error, Frame, FrameAck, Key,
+    Producer, SettingsError};
+use std::sync::{Arc, Mutex, TryLockError};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum BackendOutcome {
+    Committed(FrameAck),
+    /// Only a definite non-commit for this exact request may use this variant.
+    Rejected { request: Envelope, reason: i32 },
+    Unknown,
+}
+
+/// A trusted adapter must validate broker receipts and retain the same backend
+/// context/session for its lifetime. It must not retry, reopen, retag, or call
+/// back into this route. A successful transport write is never a Committed ACK.
+pub trait MixerBackend: Send {
+    fn baseline(&mut self) -> Result<BaselineReceipt, String>;
+    fn submit(&mut self, request: Envelope) -> BackendOutcome;
+}
+
+/// Invoked only for a matching positive ACK while admission was still open.
+/// Implementations must not reenter the route/producer. Error can mean partial
+/// effects; it closes admission and does not undo the known native commit.
+pub trait SettingsSink: Send {
+    fn commit(&mut self, ack: FrameAck) -> Result<(), String>;
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum RouteError { Gate(Error), EndpointPoisoned, Backend(String) }
+impl From<Error> for RouteError { fn from(e: Error) -> Self { Self::Gate(e) } }
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum DispatchResult {
+    Committed { settings_written: bool },
+    CommittedSettingsFailed(String),
+    Rejected { reason: i32 },
+    Unknown,
+}
+
+struct Endpoint {
+    backend: Box<dyn MixerBackend>,
+    settings: Box<dyn SettingsSink>,
+    staged: Option<BaselineReceipt>,
+}
+
+pub struct MixerRoute {
+    producer: Arc<Producer>,
+    // The immutable endpoint identity serializes submit, receipt processing,
+    // settings and baseline acquisition. Logical close deliberately needs only
+    // the producer gate, so it can close while submit is still in flight.
+    endpoint: Mutex<Endpoint>,
+}
+
+impl MixerRoute {
+    pub fn new(capacity: usize, backend: Box<dyn MixerBackend>,
+        settings: Box<dyn SettingsSink>) -> Result<Self, RouteError> {
+        Ok(Self { producer: Arc::new(Producer::new(capacity)?), endpoint: Mutex::new(
+            Endpoint { backend, settings, staged: None }) })
+    }
+    pub fn refresh_baseline(&self) -> Result<BaselineReceipt, RouteError> {
+        let mut e = self.endpoint.lock().map_err(|_| RouteError::EndpointPoisoned)?;
+        // Do not query/adopt a new backend grant over an unresolved request.
+        let s = self.producer.inspect()?;
+        if s.admission_open || s.staged || s.unresolved.is_some() {
+            return Err(RouteError::Gate(Error::Busy));
+        }
+        let receipt = e.backend.baseline().map_err(RouteError::Backend)?;
+        self.producer.stage_baseline(receipt)?;
+        self.producer.acknowledge_baseline(receipt)?;
+        e.staged = Some(receipt);
+        Ok(receipt)
+    }
+    pub fn staged_baseline(&self) -> Option<BaselineReceipt> {
+        let e = self.endpoint.try_lock().ok()?;
+        let s = self.producer.try_inspect().ok()?;
+        if s.staged && s.baseline_acknowledged { e.staged } else { None }
+    }
+    pub fn confirm_adoption(&self, receipt: BaselineReceipt, released: bool)
+        -> Result<(), RouteError> {
+        let mut e = match self.endpoint.try_lock() {
+            Ok(e) => e,
+            Err(TryLockError::WouldBlock) => return Err(RouteError::Gate(Error::Busy)),
+            Err(TryLockError::Poisoned(_)) => return Err(RouteError::EndpointPoisoned),
+        };
+        self.producer.confirm_released(receipt, released)?;
+        e.staged = None;
+        Ok(())
+    }
+    pub fn current_key(&self) -> Option<Key> {
+        let s = self.producer.try_inspect().ok()?;
+        if s.admission_open { s.last_key } else { None }
+    }
+    // Creation/close serialize with ACK+settings and may wait for a callback.
+    // Only the UI status and staged-baseline observations below are nonblocking.
+    pub fn create_for_key(&self, key: Key, frame: Frame) -> Result<Envelope, RouteError> {
+        Ok(self.producer.create_for_key(key, frame)?)
+    }
+    pub fn close(&self) -> Result<(), RouteError> {
+        self.producer.close_generation()?;
+        Ok(())
+    }
+    pub fn dispatch(&self, request: Envelope) -> Result<DispatchResult, RouteError> {
+        let mut e = match self.endpoint.lock() {
+            Ok(e) => e,
+            Err(_) => { let _ = self.producer.connection_lost();
+                return Err(RouteError::EndpointPoisoned); }
+        };
+        self.producer.admit(request)?;
+        struct InFlight<'a>(Option<&'a Producer>);
+        impl Drop for InFlight<'_> { fn drop(&mut self) {
+            if let Some(p) = self.0 { let _ = p.connection_lost(); }
+        } }
+        let mut flight = InFlight(Some(&self.producer));
+        let result = match e.backend.submit(request) {
+            BackendOutcome::Committed(ack) => {
+                match self.producer.acknowledge_frame_with_settings(ack, || e.settings.commit(ack)) {
+                    Ok(written) => Ok(DispatchResult::Committed { settings_written: written }),
+                    Err(SettingsError::Callback(error)) =>
+                        Ok(DispatchResult::CommittedSettingsFailed(error)),
+                    Err(SettingsError::Gate(error)) => Err(RouteError::Gate(error)),
+                }
+            }
+            BackendOutcome::Rejected { request: echoed, reason } if echoed == request && reason > 0 => {
+                self.producer.reject_known(request)?;
+                Ok(DispatchResult::Rejected { reason })
+            }
+            // Malformed responses may describe a committed command; never
+            // classify them as known failure or clear the unresolved envelope.
+            _ => {
+                self.producer.connection_lost()?;
+                Ok(DispatchResult::Unknown)
+            }
+        };
+        flight.0 = None;
+        result
+    }
+}
