+// SPDX-License-Identifier: GPL-3.0-only
+//! Bounded owned-mixer mailbox and dedicated worker. No device/backend factory.
+//!
+//! One port family must exclusively manage its route. Payloads are stamped and
+//! enqueued under one mutex; a separate one-token wake channel cannot consume a
+//! payload slot. Stop and Drop cannot cancel an already-started native call.
+//! Drop requests stop only. A JoinReceipt exists only after a real thread join.
+//! Creation, generation closure, and explicit stop may wait for settings; UI
+//! current-key/staged-baseline observations remain nonblocking; inspect may wait.
+//! Backend/settings callbacks must not reenter this port, route, or producer;
+//! doing so can deadlock against the ACK/settings producer lock.
+//! Native dwell is out of scope.
+
+use crate::mixer_producer::{BaselineReceipt, Envelope, Frame, Key, MAX_QUEUE};
+use crate::mixer_route::{DispatchResult, MixerRoute, RouteError};
+use std::collections::VecDeque;
+use std::sync::{Arc, Mutex, TryLockError};
+use std::sync::atomic::{AtomicU8, Ordering};
+#[cfg(test)]
+use std::sync::atomic::AtomicBool;
+use std::sync::mpsc::{self, Receiver, SyncSender};
+use std::thread::{self, JoinHandle};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[repr(u8)]
+pub enum StopReason { None=0, Requested=1, LastPortDropped=2, WorkerDropped=3,
+    SpawnFailed=4, WorkerPanicked=5, StatePoisoned=6 }
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum WorkerExit { Stopped, Panicked, StatePoisoned }
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum AttemptOutcome { Committed { settings_written: bool }, CommittedSettingsFailed,
+    Rejected(i32), Unknown, UnclassifiedError, NotForwarded, Panicked }
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct AttemptReceipt { pub request: Envelope, pub outcome: AttemptOutcome }
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct PortStatus { pub capacity: usize, pub queued: usize,
+    pub in_flight: Option<Envelope>, pub last: Option<AttemptReceipt>,
+    pub discarded: usize, pub stop_reason: StopReason,
+    pub worker_started: bool, pub worker_exited: bool }
+#[derive(Debug, PartialEq, Eq)]
+pub enum TransportError { InvalidCapacity, Terminal, Busy, Full, Poisoned,
+    SpawnFailed, Route(RouteError) }
+impl From<RouteError> for TransportError { fn from(e:RouteError)->Self { Self::Route(e) } }
+
+#[derive(Debug)]
+pub struct StopReceipt { discarded: usize, in_flight: bool }
+impl StopReceipt {
+    pub fn discarded(&self)->usize { self.discarded }
+    pub fn had_in_flight(&self)->bool { self.in_flight }
+}
+#[derive(Debug)]
+pub struct JoinReceipt { exit: WorkerExit, status: Option<PortStatus> }
+impl JoinReceipt {
+    pub fn exit(&self)->WorkerExit { self.exit }
+    pub fn status(&self)->Option<PortStatus> { self.status }
+}
+
+struct State { queue: VecDeque<Envelope>, in_flight: Option<Envelope>,
+    last: Option<AttemptReceipt>, discarded: usize, started: bool, exited: bool }
+struct Shared { route: Arc<MixerRoute>, capacity: usize, state: Mutex<State>,
+    stop: AtomicU8, wake: SyncSender<()>,
+    #[cfg(test)] confirmation_busy: AtomicBool,
+    #[cfg(test)] after_dispatch: Mutex<Option<(mpsc::Sender<()>,Receiver<()>)>>,
+}
+impl Shared {
+    fn reason(&self)->StopReason {
+        match self.stop.load(Ordering::Acquire) { 0=>StopReason::None,1=>StopReason::Requested,
+            2=>StopReason::LastPortDropped,3=>StopReason::WorkerDropped,
+            4=>StopReason::SpawnFailed,5=>StopReason::WorkerPanicked,_=>StopReason::StatePoisoned }
+    }
+    fn terminal(&self)->bool { self.stop.load(Ordering::Acquire)!=0 }
+    fn wake(&self) { let _ = self.wake.try_send(()); }
+    fn stop(&self, reason:StopReason) {
+        let _=self.stop.compare_exchange(0,reason as u8,Ordering::AcqRel,Ordering::Acquire);
+        // Full means a wake is already retained; no blocking send or data slot.
+        self.wake();
+    }
+    fn clear(s:&mut State) {
+        s.discarded=s.discarded.saturating_add(s.queue.len()); s.queue.clear();
+    }
+    fn status(&self,s:&State)->PortStatus {PortStatus {capacity:self.capacity,
+        queued:s.queue.len(),in_flight:s.in_flight,last:s.last,discarded:s.discarded,
+        stop_reason:self.reason(),worker_started:s.started,worker_exited:s.exited}}
+}
+struct PortToken { shared: Arc<Shared> }
+impl Drop for PortToken { fn drop(&mut self) {self.shared.stop(StopReason::LastPortDropped);} }
+#[derive(Clone)]
+pub struct MixerPort { token: Arc<PortToken> }
+pub struct MixerWorker { shared: Arc<Shared>, handle: Option<JoinHandle<WorkerExit>> }
+impl Drop for MixerWorker { fn drop(&mut self) {self.shared.stop(StopReason::WorkerDropped);} }
+
+/// Starts exactly one dedicated worker. Main does not call this constructor.
+pub fn channel(route:Arc<MixerRoute>,capacity:usize)->Result<(MixerPort,MixerWorker),TransportError> {
+    channel_with_spawn(route,capacity,|job|thread::Builder::new().name("owned-mixer".into()).spawn(job))
+}
+fn channel_with_spawn<F>(route:Arc<MixerRoute>,capacity:usize,spawn:F)
+    ->Result<(MixerPort,MixerWorker),TransportError>
+where F:FnOnce(Box<dyn FnOnce()->WorkerExit+Send>)->std::io::Result<JoinHandle<WorkerExit>> {
+    if capacity==0 || capacity>MAX_QUEUE {return Err(TransportError::InvalidCapacity);}
+    let (wake,rx)=mpsc::sync_channel(1);
+    let shared=Arc::new(Shared {route,capacity,state:Mutex::new(State {
+        queue:VecDeque::with_capacity(capacity),in_flight:None,last:None,discarded:0,
+        started:false,exited:false}),stop:AtomicU8::new(0),wake,
+        #[cfg(test)] confirmation_busy: AtomicBool::new(false),
+        #[cfg(test)] after_dispatch: Mutex::new(None),
+    });
+    let worker=shared.clone();
+    let handle=match spawn(Box::new(move ||worker_main(worker,rx))) {
+        Ok(h)=>h,
+        Err(_)=>{shared.stop(StopReason::SpawnFailed);let _=shared.route.close();
+            return Err(TransportError::SpawnFailed);}
+    };
+    Ok((MixerPort {token:Arc::new(PortToken {shared:shared.clone()})},
+        MixerWorker {shared,handle:Some(handle)}))
+}
+impl MixerPort {
+    fn shared(&self)->&Shared {&self.token.shared}
+    pub fn current_key(&self)->Option<Key> {
+        let p=self.shared();let _s=p.state.try_lock().ok()?;
+        if p.terminal() {None} else {p.route.current_key()}
+    }
+    pub fn staged_baseline(&self)->Option<BaselineReceipt> {
+        let p=self.shared();let s=p.state.try_lock().ok()?;
+        if p.terminal() || s.in_flight.is_some() || !s.queue.is_empty() {None}
+        else {p.route.staged_baseline()}
+    }
+    #[cfg(test)]
+    pub(crate) fn force_confirmation_busy_once_for_test(&self) {
+        self.shared().confirmation_busy.store(true,Ordering::Release);
+    }
+    #[cfg(test)]
+    pub(crate) fn confirmation_busy_pending_for_test(&self)->bool {
+        self.shared().confirmation_busy.load(Ordering::Acquire)
+    }
+    pub fn confirm_adoption(&self,b:BaselineReceipt,released:bool)->Result<(),TransportError> {
+        let p=self.shared();
+        // Test-only one-shot ownership uses the actual try_lock WouldBlock arm.
+        // The local guard is dropped before the caller handles Busy.
+        #[cfg(test)]
+        let _confirmation_test_guard=if p.confirmation_busy.swap(false,Ordering::AcqRel) {
+            Some(p.state.lock().unwrap())
+        } else {None};
+        let s=match p.state.try_lock() {
+            Ok(s)=>s,Err(TryLockError::WouldBlock)=>return Err(TransportError::Busy),
+            Err(TryLockError::Poisoned(_))=>return Err(TransportError::Poisoned)};
+        if p.terminal() {return Err(TransportError::Terminal);}
+        if s.in_flight.is_some() || !s.queue.is_empty() {return Err(TransportError::Busy);}
+        p.route.confirm_adoption(b,released)?;
+        if p.terminal() {p.route.close()?;return Err(TransportError::Terminal);}
+        Ok(())
+    }
+    pub fn refresh_baseline(&self)->Result<BaselineReceipt,TransportError> {
+        let p=self.shared();let s=p.state.lock().map_err(|_|TransportError::Poisoned)?;
+        if p.terminal() {return Err(TransportError::Terminal);}
+        if s.in_flight.is_some() || !s.queue.is_empty() {return Err(TransportError::Busy);}
+        let b=p.route.refresh_baseline()?;
+        if p.terminal() {p.route.close()?;return Err(TransportError::Terminal);}
+        Ok(b)
+    }
+    pub fn enqueue_for_key(&self,key:Key,frame:Frame)->Result<Envelope,TransportError> {
+        let p=self.shared();let mut s=p.state.lock().map_err(|_|TransportError::Poisoned)?;
+        if p.terminal() {return Err(TransportError::Terminal);}
+        if s.queue.len()+usize::from(s.in_flight.is_some())>=p.capacity {
+            Shared::clear(&mut s);p.route.close()?;return Err(TransportError::Full);
+        }
+        let e=match p.route.create_for_key(key,frame) {
+            Ok(e)=>e,
+            Err(error)=>{Shared::clear(&mut s);let _=p.route.close();return Err(error.into());}
+        };
+        if p.terminal() {Shared::clear(&mut s);p.route.close()?;return Err(TransportError::Terminal);}
+        s.queue.push_back(e);p.wake();
+        // This final terminal check defines acceptance relative to a racing
+        // Drop stop. A later stop may discard an already-accepted unsent value.
+        if p.terminal() {Shared::clear(&mut s);p.route.close()?;return Err(TransportError::Terminal);}
+        Ok(e)
+    }
+    pub fn close_generation(&self)->Result<(),TransportError> {
+        let p=self.shared();let mut s=p.state.lock().map_err(|_|TransportError::Poisoned)?;
+        Shared::clear(&mut s);p.route.close()?;Ok(())
+    }
+    /// Terminal, out-of-band, and never a cancellation or joined receipt.
+    /// May wait for a concurrent creation/settings operation to finish.
+    pub fn request_stop(&self)->Result<StopReceipt,TransportError> {
+        let p=self.shared();p.stop(StopReason::Requested);
+        let mut s=p.state.lock().map_err(|_|TransportError::Poisoned)?;
+        Shared::clear(&mut s);let r=StopReceipt {discarded:s.discarded,in_flight:s.in_flight.is_some()};
+        p.route.close()?;Ok(r)
+    }
+    pub fn inspect(&self)->Result<PortStatus,TransportError> {
+        let p=self.shared();let s=p.state.lock().map_err(|_|TransportError::Poisoned)?;Ok(p.status(&s))
+    }
+}
+impl MixerWorker {
+    /// Always requests terminal stop, then joins without any mailbox or route
+    /// lock. A panicked thread still has a joined receipt, with a distinct exit.
+    pub fn join(mut self)->Result<JoinReceipt,TransportError> {
+        self.shared.stop(StopReason::Requested);
+        let handle=self.handle.take().expect("unique worker handle");
+        let exit=match handle.join() {Ok(exit)=>exit,Err(_)=>WorkerExit::Panicked};
+        let status=self.shared.state.lock().ok().map(|s|self.shared.status(&s));
+        Ok(JoinReceipt {exit,status})
+    }
+}
+fn worker_main(p:Arc<Shared>,wake:Receiver<()>)->WorkerExit {
+    let outcome=std::panic::catch_unwind(std::panic::AssertUnwindSafe(||worker_loop(&p,&wake)));
+    let exit=match outcome {Ok(exit)=>exit,Err(_)=>{p.stop(StopReason::WorkerPanicked);WorkerExit::Panicked}};
+    if exit==WorkerExit::StatePoisoned {p.stop(StopReason::StatePoisoned);}
+    // Poison recovery here only records terminal cleanup; never admits input.
+    let mut s=p.state.lock().unwrap_or_else(|e|e.into_inner());
+    Shared::clear(&mut s);
+    if exit==WorkerExit::Panicked {
+        if let Some(e)=s.in_flight {s.last=Some(AttemptReceipt {request:e,outcome:AttemptOutcome::Panicked});}
+    }
+    // Any unresolved route request remains independent. A settings panic may
+    // instead follow a known commit; Panicked never classifies native outcome.
+    let _=p.route.close();s.exited=true;
+    exit
+}
+fn worker_loop(p:&Shared,wake:&Receiver<()>)->WorkerExit {
+    {let Ok(mut s)=p.state.lock() else{return WorkerExit::StatePoisoned};s.started=true;}
+    loop {
+        let next={
+            let Ok(mut s)=p.state.lock() else{return WorkerExit::StatePoisoned};
+            if p.terminal() {Shared::clear(&mut s);return WorkerExit::Stopped;}
+            let next=s.queue.pop_front();s.in_flight=next;next
+        };
+        let Some(e)=next else {
+            if wake.recv().is_err() {p.stop(StopReason::Requested);}
+            continue;
+        };
+        // A terminal signal after reservation can prevent forwarding. If it
+        // races later, route.close and dispatch determine whether it had begun.
+        if p.terminal() {
+            let _=p.route.close();
+            let Ok(mut s)=p.state.lock() else{return WorkerExit::StatePoisoned};
+            s.last=Some(AttemptReceipt {request:e,outcome:AttemptOutcome::NotForwarded});
+            s.in_flight=None;continue;
+        }
+        let (outcome,keep)=match p.route.dispatch(e) {
+            Ok(DispatchResult::Committed {settings_written})=>(AttemptOutcome::Committed {settings_written},settings_written),
+            Ok(DispatchResult::CommittedSettingsFailed(_))=>(AttemptOutcome::CommittedSettingsFailed,false),
+            Ok(DispatchResult::Rejected {reason})=>(AttemptOutcome::Rejected(reason),false),
+            Ok(DispatchResult::Unknown)=>(AttemptOutcome::Unknown,false),
+            Err(_)=>(AttemptOutcome::UnclassifiedError,false),
+        };
+        #[cfg(test)] {
+            // Pause after route resolution but before mailbox bookkeeping.
+            // This barrier has no production build representation.
+            let barrier=p.after_dispatch.lock().unwrap().take();
+            if let Some((entered,proceed))=barrier {
+                entered.send(()).unwrap();proceed.recv().unwrap();
+            }
+        }
+        let Ok(mut s)=p.state.lock() else{return WorkerExit::StatePoisoned};
+        s.last=Some(AttemptReceipt {request:e,outcome});s.in_flight=None;
+        if !keep {Shared::clear(&mut s);let _=p.route.close();}
+    }
+}
