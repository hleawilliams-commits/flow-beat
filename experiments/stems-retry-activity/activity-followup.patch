+    unsigned long long activity = stem_retry_play_activity(deck);
+    unsigned long long previous = g_retry_activity[deck];
+    g_retry_activity[deck] = activity;
+    if (!activity || activity == previous || (unsigned) activity != (unsigned) previous) {
         g_retry_still[deck] = 0;
         return 0;
     }
diff --git a/src/azstem/key_shift.c b/src/azstem/key_shift.c
--- a/src/azstem/key_shift.c
+++ b/src/azstem/key_shift.c
@@ -370,6 +370,22 @@
  * 0 or unknown, stems-engaged only) it holds 0 too and is published always;
  * LLONG_MAX is filtered at publish, so readers only test `>= 0`. */
 static _Atomic long long g_play_obs[NDECK];
+/* High word: valid observations; low word: observed movement. One lock-free
+ * snapshot lets the off-audio recovery worker reject loops and stale playheads.
+ * Low-word wrap also advances the high word; only freshness/equality matters. */
+_Static_assert(ATOMIC_LLONG_LOCK_FREE == 2, "audio activity counter must be lock-free");
+static _Atomic unsigned long long g_play_activity[NDECK];
+static void stem_play_observe(int deck, long long pos) {
+    long long previous = atomic_exchange_explicit(&g_play_obs[deck], pos, memory_order_relaxed);
+    unsigned long long delta = (1ULL << 32) + (previous != pos);
+    atomic_fetch_add_explicit(&g_play_activity[deck], delta, memory_order_release);
+}
+static unsigned long long stem_retry_play_activity(int deck) {
+    return deck >= 0 && deck < NDECK
+               ? atomic_load_explicit(&g_play_activity[deck], memory_order_acquire)
+               : 0;
+}
