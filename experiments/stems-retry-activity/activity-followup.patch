+/* Retry only a memory-refused track, after fresh audio observations have shown
+ * no motion for ~2 s. A loop can return to the same position between flusher
+ * ticks, and an old playhead can remain cached after observations stop. The
+ * audio hook counts every valid observation and every observed position change.
+ * No recovery is scheduled under observed motion and no repeated USB scans
  * while RAM is low. Serialize these recovery loads so a second retry observes
  * the first one's allocated buffers. Ordinary new-track loads stay unchanged. */
 static int memory_retry_ready(int deck) {
     long long need = atomic_load_explicit(&g_retry_bytes[deck], memory_order_relaxed);
     if (need <= 0)
         return 0;
-    long long pos = azstem_play_obs(deck);
-    if (pos < 0 || pos != g_retry_pos[deck]) {
