 static int ctrl_release(struct inode *inode, struct file *filp)
 {
+    unsigned long flags;
+
+    spin_lock_irqsave(&miso_lock, flags);
+    if (mixer_owner == filp)
+        mixer_owner = NULL;
+    /* Keep overlay, CRC, epoch, sequence and fence: never synthesize release
+     * input on owner death or permit queued untagged frames to resume. */
+    spin_unlock_irqrestore(&miso_lock, flags);
     return 0;
+}
+
+/* Called with miso_lock held. Explicit RELEASE may race other syscalls; final
+ * file release cannot run until in-flight file references have completed. */
+static int mixer_owned_next(struct file *filp, const struct az_overlay_command *h)
+{
+    if (mixer_owner != filp)
+        return -EACCES;
+    if (h->run_id != mixer_run || h->epoch != mixer_epoch)
+        return -ESTALE;
+    if (mixer_sequence == U64_MAX)
+        return -EOVERFLOW;
+    if (h->sequence != mixer_sequence + 1)
+        return -ESTALE;
+    return 0;
+}
+
+static long ctrl_ioctl(struct file *filp, unsigned int cmd, unsigned long arg)
+{
+    struct az_overlay_frame request;
+    struct az_overlay_command *h = &request.header;
+    unsigned long flags;
+    int ret = 0;
+    size_t size;
+
+    /* Exact command encodings validate direction and size, not just number. */
+    switch (cmd) {
+    case AZ_OVERLAY_STATE: {
+        struct az_overlay_state state = { 0 };
+
+        state.version = AZ_OVERLAY_VERSION;
+        spin_lock_irqsave(&miso_lock, flags);
+        state.flags = (mixer_fenced ? AZ_OVERLAY_FENCED : 0) |
+                      (mixer_owner ? AZ_OVERLAY_ACTIVE : 0) |
+                      (mixer_owner == filp ? AZ_OVERLAY_CALLER_OWNER : 0) |
+                      (has_inject[OWNED_BUS] ? AZ_OVERLAY_INJECTED : 0);
+        state.run_id = mixer_run;
+        state.epoch = mixer_epoch;
+        state.sequence = mixer_sequence;
+        state.crc_len = spi_crc_len[OWNED_BUS];
+        memcpy(state.frame, has_inject[OWNED_BUS] ? inject_pending[OWNED_BUS] :
+               az_bus_frame[OWNED_BUS], MISO_SIZE);
+        spin_unlock_irqrestore(&miso_lock, flags);
+        return xput_bytes((void __user *)arg, (u8 *)&state, sizeof(state));
+    }
+    case AZ_OVERLAY_CLAIM:
+    case AZ_OVERLAY_RELEASE:
+        size = sizeof(*h);
+        break;
+    case AZ_OVERLAY_FRAME:
+        size = sizeof(request);
+        break;
+    default:
+        return -ENOTTY;
+    }
+
+    if (!(filp->f_mode & FMODE_WRITE))
+        return -EBADF;
+    if (!capable(CAP_SYS_ADMIN))
+        return -EPERM;
+    if (!allow_overlay_ownership)
+        return -EOPNOTSUPP;
+    if (xget_bytes((u8 *)&request, (const void __user *)arg, size))
+        return -EFAULT;
+    if (h->version != AZ_OVERLAY_VERSION || h->reserved || !h->run_id)
+        return -EINVAL;
+
+    spin_lock_irqsave(&miso_lock, flags);
+    if (cmd == AZ_OVERLAY_CLAIM) {
+        if (h->sequence)
+            ret = -EINVAL;
+        else if (mixer_owner)
+            ret = -EBUSY;
+        else if (h->epoch != mixer_epoch)
+            ret = -ESTALE;
+        else if (mixer_epoch == U64_MAX)
+            ret = -EOVERFLOW;
+        else if (spi_crc_len[OWNED_BUS] != OWNED_CRC)
+            ret = -EINVAL;
+        else {
+            mixer_epoch++;
+            mixer_sequence = 0;
+            mixer_run = h->run_id;
+            mixer_owner = filp;
+            mixer_fenced = true;
+        }
+    } else {
+        ret = mixer_owned_next(filp, h);
+        if (!ret) {
+            if (cmd == AZ_OVERLAY_FRAME) {
+                memcpy(inject_pending[OWNED_BUS], request.frame, MISO_SIZE);
+                has_inject[OWNED_BUS] = 1;
+            } else {
+                mixer_owner = NULL;
+            }
+            mixer_sequence = h->sequence;
+        }
+    }
+    spin_unlock_irqrestore(&miso_lock, flags);
+    return ret;
 }
 
