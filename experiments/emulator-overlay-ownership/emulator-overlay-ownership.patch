+static int crc_lengths_get(char *buf, const struct kernel_param *kp)
+{
+    int values[N_SPI], count, i, len = 0;
+    unsigned long flags;
+
+    spin_lock_irqsave(&miso_lock, flags);
+    memcpy(values, spi_crc_len, sizeof(values));
+    count = n_crc;
+    spin_unlock_irqrestore(&miso_lock, flags);
+    for (i = 0; i < count; i++)
+        len += scnprintf(buf + len, PAGE_SIZE - len, "%s%d", i ? "," : "", values[i]);
+    return len;
+}
