--- /dev/null
+++ b/guest/modules/subucom_virt/subucom_ownership.h
@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SUBUCOM_OWNERSHIP_H
+#define SUBUCOM_OWNERSHIP_H
+
+#include <linux/types.h>
+#include <linux/ioctl.h>
+
+#define AZ_OVERLAY_VERSION 1u
+#define AZ_OVERLAY_BYTES 152
+#define AZ_OVERLAY_FENCED 1u
+#define AZ_OVERLAY_ACTIVE 2u
+#define AZ_OVERLAY_CALLER_OWNER 4u
+#define AZ_OVERLAY_INJECTED 8u
+
+struct az_overlay_command {
+    __u32 version;
+    __u32 reserved;
+    __aligned_u64 run_id;
+    __aligned_u64 epoch;
+    __aligned_u64 sequence;
+};
+
+struct az_overlay_frame {
+    struct az_overlay_command header;
+    __u8 frame[AZ_OVERLAY_BYTES];
+};
+
+struct az_overlay_state {
+    __u32 version;
+    __u32 flags;
+    __aligned_u64 run_id;
+    __aligned_u64 epoch;
+    __aligned_u64 sequence;
+    __s32 crc_len;
+    __u32 reserved;
+    __u8 frame[AZ_OVERLAY_BYTES];
+};
+
+/* Native 64-bit ABI only; no compat ioctl handler is provided. CLAIM and
+ * RELEASE have no output after commit. STATE is a snapshot, not delivery ACK. */
+#define AZ_OVERLAY_CLAIM _IOW('Z', 0x50, struct az_overlay_command)
+#define AZ_OVERLAY_FRAME _IOW('Z', 0x51, struct az_overlay_frame)
+#define AZ_OVERLAY_RELEASE _IOW('Z', 0x52, struct az_overlay_command)
+#define AZ_OVERLAY_STATE _IOR('Z', 0x53, struct az_overlay_state)
+
+#endif
