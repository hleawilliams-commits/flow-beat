+/* Parse a complete request in private storage. A malformed list, or a mixer
+ * prefix change after acquisition, cannot partially change any live prefix.
+ * Short valid lists still replace only their supplied prefix and set n_crc. */
+static int crc_lengths_set(const char *val, const struct kernel_param *kp)
+{
+    int parsed[N_SPI], count = 0, ret = 0;
+    char *copy, *cursor, *token;
+    unsigned long flags;
+
+    copy = kstrdup(val, GFP_KERNEL);
+    if (!copy)
+        return -ENOMEM;
+    cursor = copy;
+    while ((token = strsep(&cursor, ",")) != NULL) {
+        if (count == N_SPI) {
+            ret = -EINVAL;
+            goto out;
+        }
+        ret = kstrtoint(token, 0, &parsed[count]);
+        if (ret)
+            goto out;
+        count++;
+    }
+    spin_lock_irqsave(&miso_lock, flags);
+    if (mixer_fenced && count > OWNED_BUS && parsed[OWNED_BUS] != OWNED_CRC) {
+        ret = -EBUSY;
+    } else {
+        memcpy(spi_crc_len, parsed, count * sizeof(parsed[0]));
+        n_crc = count;
+    }
+    spin_unlock_irqrestore(&miso_lock, flags);
+out:
+    kfree(copy);
+    return ret;
+}
