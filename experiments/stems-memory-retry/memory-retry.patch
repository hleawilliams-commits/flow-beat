+/* Retry only a memory-refused track, after a known playhead has stayed still
+ * for ~2 s. No switch to stems under a moving track and no repeated USB scans
+ * while RAM is low. Serialize these recovery loads so a second retry observes
+ * the first one's allocated buffers. Ordinary new-track loads stay unchanged. */
+static int memory_retry_ready(int deck) {
+    long long need = atomic_load_explicit(&g_retry_bytes[deck], memory_order_relaxed);
+    if (need <= 0)
+        return 0;
+    long long pos = azstem_play_obs(deck);
+    if (pos < 0 || pos != g_retry_pos[deck]) {
+        g_retry_pos[deck] = pos;
+        g_retry_still[deck] = 0;
+        return 0;
+    }
+    if (g_retry_still[deck] < 10) {
+        g_retry_still[deck]++;
+        return 0;
+    }
+    long now = ms_now();
+    if (now < g_retry_after[deck])
+        return 0;
+    g_retry_after[deck] = now + 2000;
+    for (int d = 0; d < NDECK; d++)
+        if (atomic_load_explicit(&g_stem_loading[d], memory_order_acquire))
+            return 0;
+    long long avail = mem_available_bytes();
+    return avail >= 0 && avail - need >= ((long long) AZSTEM_MEM_FLOOR_MB << 20);
+}
